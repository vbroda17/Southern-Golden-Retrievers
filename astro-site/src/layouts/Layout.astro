---
// src/layouts/Layout.astro
import { getImage } from 'astro:assets';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import { SITE_CONFIG } from '../config.js';
import { url } from '../utils.js';
import shareImageSource from '../assets/images/Group/group2-2.jpeg';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  noindex?: boolean; // Keep this page out of search results (e.g. the 404 page)
}

const {
  title,
  description = SITE_CONFIG.defaultDescription,
  noindex = false
} = Astro.props;

// Full URL of this page, so search engines and link previews use one address for it
const canonicalUrl = new URL(Astro.url.pathname, Astro.site).href;

// Photo shown when a page is shared (Facebook, iMessage, etc.); JPEG since not every app previews webp
const shareImage = await getImage({ src: shareImageSource, width: 1200, format: 'jpg' });
const shareImageUrl = new URL(shareImage.src, Astro.site).href;

// Structured data for Google
const structuredData = {
  "@context": "https://schema.org",
  "@type": "PetStore",
  "name": SITE_CONFIG.name,
  "description": description,
  "url": new URL(url(''), Astro.site).href,
  "email": SITE_CONFIG.email,
  "image": shareImageUrl,
  "address": {
    "@type": "PostalAddress",
    "addressLocality": "Knoxville",
    "addressRegion": "TN",
    "addressCountry": "US"
  },
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": "35.9606",
    "longitude": "-83.9207"
  }
};
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content={description}>
  {noindex ? <meta name="robots" content="noindex"> : <link rel="canonical" href={canonicalUrl}>}

  <!-- Geographic meta tags for local SEO -->
  <meta name="geo.region" content="US-TN">
  <meta name="geo.placename" content="Knoxville">
  <meta name="geo.position" content="35.9606;-83.9207">
  
  <!-- Open Graph for social sharing -->
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <meta property="og:type" content="website">
  <meta property="og:locale" content="en_US">
  <meta property="og:url" content={canonicalUrl}>
  <meta property="og:site_name" content={SITE_CONFIG.name}>
  <meta property="og:image" content={shareImageUrl}>
  <meta property="og:image:width" content={String(shareImage.attributes.width)}>
  <meta property="og:image:height" content={String(shareImage.attributes.height)}>
  <meta property="og:image:alt" content="Our golden retrievers">
  <meta name="twitter:card" content="summary_large_image">

  <!-- Structured Data for Google -->
  <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  
  <title>{title}</title>
  <link rel="icon" type="image/svg+xml" href={url('favicon.svg')}>
  <link rel="sitemap" href={url('sitemap-index.xml')}>
</head>
<body>
  <Navbar />
  <main>
    <slot />
  </main>
  <Footer />
  <!-- External Scripts -->
  <script src="../scripts/copy-email.js"></script>
</body>
</html>