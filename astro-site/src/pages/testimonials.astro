---
// src/pages/testimonials.astro
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import testimonialImage from '../assets/images/Group/group2-4.jpeg';
import { url } from '../utils.js';
import '../styles/testimonials.css';

const title = "Testimonials | Southern Golden Retrievers";
const description = "Hear from families who brought home a Southern Golden Retrievers puppy. Located in Knoxville, TN.";
---

<Layout title={title} description={description}>
  <div class="container">
        <section class="hero">
            <h1>Testimonials</h1>
            <p>We're proud of our dogs, and so are the families who brought one home. Here are some of their stories. (These are placeholder stories for now.)</p>
        </section>

        <!-- Testimonial Card - Image on Left -->
        <div class="testimonial-card">
            <div class="testimonial-image-wrapper">
                <Image src={testimonialImage}
                    alt="Customer with their Golden Retriever"
                    width={600}
                    widths={[300, 600]}
                    sizes="(max-width: 800px) 400px, 300px"
                    class="testimonial-image" />
            </div>
            <div class="testimonial-content">
                <blockquote class="testimonial-quote">
                    "Our Golden Retriever from Southern Golden Retrievers has been the best addition to our family. The entire process was smooth, and they were so helpful every step of the way!"
                </blockquote>
                <p class="testimonial-author">— The Smith Family</p>
                <p class="testimonial-date">Brought their pup home in spring 2024</p>
            </div>
        </div>

        <!-- Testimonial Card - Image on Right -->
        <div class="testimonial-card reverse">
            <div class="testimonial-image-wrapper">
                <Image src={testimonialImage}
                    alt="Happy customer with Golden Retriever"
                    width={600}
                    widths={[300, 600]}
                    sizes="(max-width: 800px) 400px, 300px"
                    class="testimonial-image" />
            </div>
            <div class="testimonial-content">
                <blockquote class="testimonial-quote">
                    "We couldn't be happier with our puppy! The care and attention to detail from the breeder was exceptional. Our pup is healthy, happy, and so well-adjusted."
                </blockquote>
                <p class="testimonial-author">— John &amp; Sarah</p>
                <p class="testimonial-date">Brought their pup home in fall 2023</p>
            </div>
        </div>

        <section class="card cta-card">
            <h2>Ready for Your Own Golden?</h2>
            <p>See who's available now, check Puppy News to see which mom is having puppies next, or look back at our past litters.</p>
            <a class="btn" href={url('current-litters')}>Current Litters</a>
            <a class="btn" href={url('puppy-news')}>Puppy News</a>
            <a class="btn" href={url('past-litters')}>Past Litters</a>
        </section>
    </div>
</Layout>