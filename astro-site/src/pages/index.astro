---
// src/pages/index.astro
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import heroImage from '../assets/images/Group/group2-2.jpeg';
import EmailLink from '../components/EmailLink.astro';
import { getCurrentLitters } from '../litters.js';
import { getPlannedLitters } from '../puppy-news.js';
import { url, countOf } from '../utils.js';
import { SITE_CONFIG } from '../config.js';
import '../styles/index.css';

const title = "Southern Golden Retrievers";
const description = "Raised with Love. Backed by Excellence. See why our puppies are the perfect addition to your family.";

const currentLitters = await getCurrentLitters();

const litterCount = currentLitters.length;

// The first planned litter in Pages CMS → Puppy News is the one teased here
const nextLitter = getPlannedLitters()[0];
---

<Layout title={title} description={description}>
  <div class="container">
    <section class="hero">
      <h1>Raised with Love. Backed by Excellence.</h1>
      <p>See why our puppies are the perfect addition to your family.</p>
       <Image src={heroImage}
       alt="Our Three Golden Retrievers"
       width={1600}
       widths={[600, 1000, 1600]}
       sizes="(max-width: 1000px) 100vw, 1000px"
       class="showcase-image" />
    </section>
    
    <div class="home-card-grid">
      <section class="card">
        <h2>Meet Our Moms</h2>
        <p>Lilly, Raine, and Roux are the three most beautiful, kind, and smart dogs we could ask for.<br> Award winning and loving, they have made great additions to our home.</p>
        <a href={url('dams')} class="btn">Learn More About Each Mom</a>
      </section>

      <section class="card">
        <h2>View Our Litters</h2>
        {litterCount > 0 ? (
          <>
            <p>See who is available in our current {litterCount === 1 ? 'litter' : 'litters'}. See previous pups in our <a href={url('past-litters')}>past litters</a> and <a href={url('testimonials')}>testimonials</a>.</p>
            <p>Right now, we have {countOf(litterCount, 'litter')}. Take a look and reserve your future puppy today!</p>
            <a href={url('current-litters')} class="btn">{litterCount === 1 ? 'Current Litter' : 'Current Litters'}</a>
          </>
        ) : (
          <>
            <p>See previous pups in our <a href={url('past-litters')}>past litters</a> and <a href={url('testimonials')}>testimonials</a>.</p>
            <p>We don't have any litters right now, but more are planned. Join our waiting list to hear first when puppies arrive!</p>
            <a href={url('current-litters')} class="btn">Join the Waiting List</a>
          </>
        )}
      </section>

      <section class="card">
        <h2>About Us</h2>
        <p>Interested in a pup? Contact us via email at <EmailLink showCopy={true}/> or look at our contact page.</p>
        <p>Curious about us and what we stand for. We invite you to learn more about us.</p>
        <a href={url('contact')} class="btn">Contact</a>
        <a href={url('about')} class="btn">About</a>
      </section>
    </div>

    <section class="card home-news">
      <h2>Puppy News</h2>
      {nextLitter ? (
        <p>
          Next up: <strong>{nextLitter.sire ? `${nextLitter.dam.name} × ${nextLitter.sire.name}` : `${nextLitter.dam.name}'s next litter`}</strong>{nextLitter.expected ? <>, likely around <strong>{nextLitter.expected}</strong></> : null}.
          Send us an email to join the waitlist so you don't miss out!
        </p>
      ) : (
        <p>We're planning our next litters now. Send us an email to join the waitlist so you don't miss out!</p>
      )}
      <a href={url('puppy-news')} class="btn">See Puppy News</a>
      <a href={`mailto:${SITE_CONFIG.email}?subject=${encodeURIComponent('Waitlist Inquiry')}`} class="btn">Join the Waitlist</a>
    </section>
  </div>
</Layout>