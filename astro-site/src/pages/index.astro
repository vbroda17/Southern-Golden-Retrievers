---
// src/pages/index.astro
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import heroImage from '../assets/images/Group/group2-2.jpeg';
import EmailLink from '../components/EmailLink.astro';
import { getCurrentLitters } from '../litters.js';
import { getPlannedLitters } from '../puppy-news.js';
import { url, countOf } from '../utils.js';
import { SITE_CONFIG } from '../config.js';
import '../styles/index.css';

const title = "Southern Golden Retrievers";
const description = "Raised with Love. Backed by Excellence. See why our puppies are the perfect addition to your family.";

const currentLitters = await getCurrentLitters();

const litterCount = currentLitters.length;

// The first planned litter in Pages CMS → Puppy News is the one teased here
const nextLitter = getPlannedLitters()[0];
---

<Layout title={title} description={description}>
  <div class="container">
    <section class="hero">
      <h1>Raised with Love. Backed by Excellence.</h1>
      <p>See why our puppies make the perfect addition to your family.</p>
       <Image src={heroImage}
       alt="Our Three Golden Retrievers"
       width={1600}
       widths={[600, 1000, 1600]}
       sizes="(max-width: 1000px) 100vw, 1000px"
       class="showcase-image" />
    </section>
    
    <div class="home-card-grid">
      <section class="card">
        <h2>Meet Our Moms</h2>
        <p>Lilly and Roux are beautiful, gentle, and smart, and they make wonderful moms. Roux even earned Best in Show at just 11 months old.</p>
        <p>Our sweet Raine is now retired and still a big part of our family.</p>
        <a href={url('dams')} class="btn">Meet Our Dams</a>
      </section>

      <section class="card">
        <h2>View Our Litters</h2>
        {litterCount > 0 ? (
          <>
            <p>Right now we have {countOf(litterCount, 'litter')}. See who's available and reserve your future puppy today!</p>
            <p>You can also see our past litters and testimonials.</p>
            <a href={url('current-litters')} class="btn">Current Litters</a>
            <a href={url('past-litters')} class="btn">Past Litters</a>
            <a href={url('testimonials')} class="btn">Testimonials</a>
          </>
        ) : (
          <>
            <p>We don't have any litters right now, but more are on the way. Check Puppy News below to see what's next.</p>
            <p>In the meantime, see our past litters and testimonials.</p>
            <a href={url('past-litters')} class="btn">Past Litters</a>
            <a href={url('testimonials')} class="btn">Testimonials</a>
          </>
        )}
      </section>

      <section class="card">
        <h2>About Us</h2>
        <p>Interested in a puppy? Email us at <EmailLink showCopy={true}/>.</p>
        <p>Want to know more about who we are and what we stand for? We'd love to tell you.</p>
        <a href={url('contact')} class="btn">Contact</a>
        <a href={url('about')} class="btn">About</a>
      </section>
    </div>

    <section class="card home-news">
      <h2>Puppy News</h2>
      {nextLitter ? (
        <p>
          Next up: <strong>{nextLitter.sire ? `${nextLitter.dam.name} × ${nextLitter.sire.name}` : `${nextLitter.dam.name}'s next litter`}</strong>{nextLitter.expected ? <>, likely around <strong>{nextLitter.expected}</strong></> : null}.
          Send us an email to join the waitlist so you don't miss out!
        </p>
      ) : (
        <p>We're planning our next litters now. Send us an email to join the waitlist so you don't miss out!</p>
      )}
      <a href={url('puppy-news')} class="btn">Puppy News</a>
      <a href={`mailto:${SITE_CONFIG.email}?subject=${encodeURIComponent('Waitlist Inquiry')}`} class="btn">Join the Waitlist</a>
    </section>
  </div>
</Layout>