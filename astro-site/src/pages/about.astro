---
// src/pages/about.astro
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import showcaseImage from '../assets/images/Group/group2-4.jpeg';
import EmailLink from '../components/EmailLink.astro';
import { url } from '../utils.js';

const title = "About | Southern Golden Retrievers";
const description = "Learn about us and how we make sure you get the perfect pup. Located in Knoxville, TN.";
---

<Layout title={title} description={description}>
  <div class="container">
        <section class="hero">
            <h1>About Us!</h1>
            <p>Southern Golden Retrievers is a dedicated breeder of high-quality Golden Retrievers. We focus on producing healthy, well-socialized puppies with excellent temperaments and strong genetic lines.</p>
            <p>We are a family of passionate breeders committed to maintaining the highest standards in our breeding program.</p>
            <p>From the Knoxville area, we are dedicated to finding loving homes for our puppies.</p>
            <p>To get in touch with us, please email us at <EmailLink showCopy={true} />.</p>
            <p>Feel free to explore more about us in the meantime.</p>
            <a class="btn" href={url("dams")}>Dams</a>
            <a class="btn" href={url("current-litters")}>Current Litters</a>
            <a class="btn" href={url("testimonials")}>Testimonials</a>
            <a class="btn" href={url("faq")}>FAQ</a>
            <a class="btn" href={url("contact")}>Contact Us</a>
        </section>

        <section class="card">
            <Image src={showcaseImage}
                alt="Our Three Golden Retrievers"
                width={1600}
                widths={[600, 1000, 1600]}
                sizes="(max-width: 1000px) 100vw, 1000px"
                class="showcase-image" />
        </section>
  </div>
</Layout>