---
// src/pages/about.astro
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import showcaseImage from '../assets/images/Group/group2-4.jpeg';
import EmailLink from '../components/EmailLink.astro';
import { url } from '../utils.js';

const title = "About | Southern Golden Retrievers";
const description = "Learn about Southern Golden Retrievers, a family golden retriever breeder in the Knoxville, TN area.";
---

<Layout title={title} description={description}>
  <div class="container">
        <section class="hero">
            <h1>About Us</h1>
            <p>Southern Golden Retrievers is a family breeder of high-quality Golden Retrievers in the Knoxville area. We focus on raising healthy, well-socialized puppies with excellent temperaments and strong genetic lines.</p>
            <p>We hold our breeding program to the highest standards, and our goal is simple: to find a loving home for every puppy.</p>
            <p>To get in touch, email us at <EmailLink showCopy={true} />.</p>
            <a class="btn" href={url("dams")}>Dams</a>
            <a class="btn" href={url("current-litters")}>Current Litters</a>
            <a class="btn" href={url("testimonials")}>Testimonials</a>
            <a class="btn" href={url("faq")}>FAQ</a>
            <a class="btn" href={url("contact")}>Contact</a>
        </section>

        <section class="card">
            <Image src={showcaseImage}
                alt="Our Three Golden Retrievers"
                width={1600}
                widths={[600, 1000, 1600]}
                sizes="(max-width: 1000px) 100vw, 1000px"
                class="showcase-image" />
        </section>
  </div>
</Layout>