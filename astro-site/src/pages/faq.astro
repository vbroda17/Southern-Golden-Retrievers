---
// src/pages/faq.astro
// Questions and answers come from src/content/faq.json (edit in Pages CMS)
import Layout from '../layouts/Layout.astro';
import EmailLink from '../components/EmailLink.astro';
import { getFaq, paragraphs } from '../faq.js';
import { url } from '../utils.js';
import '../styles/faq.css';

const title = "FAQ | Southern Golden Retrievers";
const description = "Answers to common questions about our golden retriever puppies: the waitlist, deposits, health, and bringing your puppy home. Knoxville, TN.";

const { intro, sections } = getFaq();

// Structured data so search engines can recognize the questions and answers
const faqStructuredData = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": sections.flatMap(section => section.questions.map(q => ({
    "@type": "Question",
    "name": q.question,
    "acceptedAnswer": { "@type": "Answer", "text": q.answer }
  })))
};
---

<Layout title={title} description={description}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(faqStructuredData)} />

  <div class="container">
    <section class="hero">
      <h1>Frequently Asked Questions</h1>
      {intro && <p>{intro}</p>}
    </section>

    {sections.map(section => (
      <section class="card faq-section">
        <h2>{section.title}</h2>
        {section.questions.map(q => (
          <details class="faq-item">
            <summary class="faq-question">{q.question}</summary>
            <div class="faq-answer">
              {paragraphs(q.answer).map(p => <p>{p}</p>)}
            </div>
          </details>
        ))}
      </section>
    ))}

    <section class="card faq-contact">
      <h2>Still Have a Question?</h2>
      <p>Email us at <EmailLink showCopy={true} subject="Question About Your Puppies" /> and we'll get back to you.</p>
      <a class="btn" href={url('current-litters')}>Current Litters</a>
      <a class="btn" href={url('puppy-news')}>Puppy News</a>
    </section>
  </div>
</Layout>
