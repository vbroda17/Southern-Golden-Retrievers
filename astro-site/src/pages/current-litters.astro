---
// src/pages/current-litters.astro
import Layout from '../layouts/Layout.astro';
import EmailLink from '../components/EmailLink.astro';
import LitterSection from '../components/LitterSection.astro';
import { getCurrentLitters } from '../litters.js';
import { url } from '../utils.js';
import { SITE_CONFIG } from '../config.js';
import '../styles/current-litters.css';

const title = "Current Litters | Southern Golden Retrievers";
const description = "View our current litters of golden retriever puppies available in Knoxville, TN.";

const currentLitters = await getCurrentLitters();
---

<Layout title={title} description={description}>
    <div class="container">
        <section class="hero">
            <h1>Current Litters</h1>
            {currentLitters.length > 0 ? (
              <p>Meet the golden retriever puppies we have available now. Our moms are health tested and certified, so you can expect a strong, healthy puppy who will be a great addition to your family. See which pup steals your heart!</p>
            ) : (
              <p>Our moms are health tested and certified, so you can expect strong, healthy puppies who will be a great addition to your family.</p>
            )}
            <p>Have a question? Email us at <EmailLink showCopy={true} />.</p>
        </section>

        <!-- Quick Navigation -->
        {currentLitters.length > 1 && (
          <div class="litter-nav card">
            <h2>Jump to a Litter</h2>
            <div class="litter-nav-buttons">
              {currentLitters.map(litter => (
                <a href={`#${litter.id}`} class="btn">
                  {litter.dam.name}'s Litter
                </a>
              ))}
            </div>
          </div>
        )}

        <!-- Display Each Litter -->
        {currentLitters.map(litter => (
          <LitterSection litter={litter} />
        ))}

        <!-- No Litters Message -->
        {currentLitters.length === 0 && (
          <section class="card no-litters">
            <h2>No Current Litters</h2>
            <p>We don't have any puppies available right now, but more litters are planned! See what's coming next in Puppy News, and send us an email to join the waitlist so you don't miss out.</p>
            <a class="btn" href={url("puppy-news")}>Puppy News</a>
            <a class="btn" href={`mailto:${SITE_CONFIG.email}?subject=${encodeURIComponent('Waitlist Inquiry')}`}>Join the Waitlist</a>
          </section>
        )}

        <!-- Contact CTA (the No Litters message already covers this when there are none) -->
        {currentLitters.length > 0 && (
          <section class="card contact-cta">
              <h2>Interested in a Puppy?</h2>
              <p>Email us at <EmailLink showCopy={true} subject="Interested in a Puppy" /> to learn more about bringing one of our puppies home.</p>
              <p>Questions about deposits, health, or pickup? Many answers are in our FAQ. You can also see how our past litters grew up.</p>
              <a class="btn" href={url("faq")}>FAQ</a>
              <a class="btn" href={url("past-litters")}>Past Litters</a>
              <a class="btn" href={url("contact")}>Contact</a>
          </section>
        )}
    </div>
</Layout>