---
// src/pages/contact.astro
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import showcaseImage from '../assets/images/Group/group2-3.jpeg';
import EmailLink from '../components/EmailLink.astro';
import { getCurrentLitters } from '../litters.js';
import { url, countOf } from '../utils.js';

const title = "Contact | Southern Golden Retrievers";
const description = "Contact us today and get your perfect golden retriever pup. Located in Knoxville, TN.";

const currentLitters = await getCurrentLitters();

const litterCount = currentLitters.length;
---

<Layout title={title} description={description}>
  <div class="container">
            <section class="hero">
            <h1>Contact Us!</h1>
            {litterCount > 0 ? (
              <p>We currently have {countOf(litterCount, 'litter')}. If you would like to get in touch with us for more information, please email us at <EmailLink showCopy={true} />.</p>
            ) : (
              <p>We don't have any litters right now, but more are planned. If you would like to join our waiting list or get more information, please email us at <EmailLink showCopy={true} subject="Waiting List Inquiry" />.</p>
            )}
            <p>Have a question about the waiting list, deposits, health, or pickup? Many answers are in our <a href={url("faq")}>FAQ</a>.</p>
            <p>In the meantime, explore our other pages to learn more about our dams, current litters, and us.</p>
            <a class="btn" href={url("dams")}>Dams</a>
            <a class="btn" href={url("current-litters")}>Current Litters</a>
            <a class="btn" href={url("faq")}>FAQ</a>
            <a class="btn" href={url("about")}>About Us</a>
        </section>

        <section class="card">
            <Image src={showcaseImage}
                alt="Our Three Golden Retrievers"
                width={1600}
                widths={[600, 1000, 1600]}
                sizes="(max-width: 1000px) 100vw, 1000px"
                class="showcase-image" />
        </section>
  </div>
</Layout>