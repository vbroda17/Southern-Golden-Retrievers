---
// src/components/Navbar.astro
import { SITE_CONFIG } from '../config.js';
import { url } from '../utils.js';
import '../styles/navbar.css';

const currentPath = Astro.url.pathname;

const navLinks = [
  { path: '', label: 'Home' },
  { path: 'current-litters', label: 'Current Litters' },
  { path: 'dams', label: 'Dams' },
  { path: 'testimonials', label: 'Testimonials' },
  { path: 'contact', label: 'Contact' },
  { path: 'about', label: 'About' }
];

// Home only matches exactly; other pages match anywhere in the path
const isActive = (path: string) => path === '' ? currentPath === url('') : currentPath.includes(path);
---

<!-- Top Info Bar -->
<div class="top-bar">
  <div class="container">
    <div class="top-bar-content">
      <span class="top-bar-location">📍 Knoxville, TN</span>
      <button 
        class="top-bar-email copy-email-btn" 
        data-email={SITE_CONFIG.email}
        title="Click to copy email address"
      >
        📧 {SITE_CONFIG.email}
      </button>
    </div>
  </div>
</div>

<!-- Main Navbar -->
<header class="site-header">
  <div class="container">
    <div class="header-inner">
      <a href={url('')} class="brand">Southern Golden Retrievers</a>
      <nav class="nav">
        {navLinks.map(({ path, label }) => (
          <a
            href={url(path)}
            class={`nav-link ${isActive(path) ? 'active' : ''}`}
            aria-current={isActive(path) ? 'page' : undefined}
          >{label}</a>
        ))}
      </nav>
    </div>
  </div>
</header>